{
  "name": "historia-oscura-pipeline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pipeline: tema hist\u00f3rico \u2192 v\u00eddeo de YouTube de ~12 min (voz ElevenLabs, ilustraciones fal, montaje Remotion)",
  "scripts": {
    "new": "tsx src/cli/new.ts",
    "produce": "tsx src/cli/produce.ts",
    "stage": "tsx src/cli/stage.ts",
    "studio": "remotion studio remotion/index.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p remotion",
    "test": "tsx --test src/core/*.test.ts",
    "test:e2e": "rm -rf episodes/prueba-mock && cp -r test/fixture-mock episodes/prueba-mock && PIPELINE_MOCK=1 tsx src/cli/produce.ts prueba-mock || true",
    "setup:voice": "bash scripts/setup-kokoro.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.9.0",
    "@elevenlabs/elevenlabs-js": "^2.79.0",
    "@fal-ai/client": "^1.11.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.1",
    "@remotion/bundler": "^4.0.544",
    "@remotion/cli": "^4.0.544",
    "@remotion/media": "^4.0.544",
    "@remotion/renderer": "^4.0.544",
    "commander": "^15.1.0",
    "dotenv": "^18.0.10",
    "p-limit": "^7.3.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.544",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
